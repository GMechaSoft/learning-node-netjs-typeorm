# Base de datos (PostgreSQL) — solo variables de entorno, nunca hardcoded (GPS §Seguridad)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=tareas_db
# Solo desarrollo; en producción usar migraciones (coding-standards §Evolución)
DB_SYNCHRONIZE=true

# Autenticación (precondición operativa HU #1)
JWT_SECRET=cambiar-en-produccion
JWT_EXPIRES_IN=1h
