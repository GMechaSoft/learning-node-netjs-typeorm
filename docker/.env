# Credenciales de runtime de la demo (academica) para la imagen unificada.
# SOLO para demostracion; no usar en entornos reales.
# Se carga via `env_file` en docker-compose.demo.yml (o via docker run --env-file).

# --- PostgreSQL (initdb del contenedor) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tareas_db

# --- Conexion de la API a PostgreSQL (dentro de la misma imagen: localhost) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=tareas_db
# Modo desarrollo: TypeORM crea/ajusta el schema al arrancar (ver GPS / coding-standards)
DB_SYNCHRONIZE=true

# --- Autenticacion (JWT) ---
JWT_SECRET=demo-secret-academica
JWT_EXPIRES_IN=7d

# --- Puerto de la API dentro de la imagen ---
PORT=8080
